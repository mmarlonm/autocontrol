PORT=3000
NODE_ENV=production

# Supabase PostgreSQL (obtener de Supabase console)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@xxxx.supabase.co:5432/postgres
DB_HOST=xxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.xxxx
DB_PASSWORD=YOUR_PASSWORD

# Firebase (obtener de firebase-service-account.json)
FIREBASE_SERVICE_ACCOUNT_PATH=./src/config/firebase-service-account.json

# JWT (cambiar a algo más seguro)
JWT_SECRET=GENERAR_CON: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Scraper
PYTHON_PATH=python3
SCRAPER_SCRIPT_PATH=./scrapers/main.py
CRON_SCHEDULE=0 8 * * *

# Frontend URL (actualizar con tu dominio)
FRONTEND_URL=https://tu-app.expo.dev
